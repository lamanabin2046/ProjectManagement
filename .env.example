# Copy this file to .env and fill in the values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# SaaS manager runs on BASE_DOMAIN, each palika on <subdomain>.BASE_DOMAIN
BASE_DOMAIN=localhost
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
# e.g. https://pms.example.com,https://*.pms.example.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL (docker-compose.yml starts one on port 5433)
DB_NAME=bpm
DB_USER=bpm
DB_PASSWORD=bpm
DB_HOST=127.0.0.1
DB_PORT=5433

# राष्ट्रिय परिचयपत्र (NID) खोज — तीनमध्ये एउटा:
#   खाली                → यही पालिकाका पुराना सदस्यमा मात्र खोजिन्छ
#   demo                → डेमो (काल्पनिक) data, server चाहिँदैन
#   http://127.0.0.1:8765/api/person/{nid}/   → `python manage.py nid_demo_server`
#   https://<सरकारी API>/.../{nid}/            → वास्तविक प्रणाली
NID_API_URL=
NID_API_KEY=
